[Unit]
Description=Week 4 Read-Only Visitor Counter
After=network.target mariadb.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/week4-reader
ExecStart=/home/ubuntu/week4-reader/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:5001 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
